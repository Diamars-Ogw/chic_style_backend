# ============================================
# Chic Style — Backend — Variables d'environnement
# ============================================

# URL de connexion PostgreSQL local
# Format : postgresql://UTILISATEUR:MOT_DE_PASSE@localhost:5432/NOM_DE_LA_BASE
DATABASE_URL=postgresql://postgres:2103@localhost:5432/chicstyle

# Secret pour signer les JWT admin
JWT_SECRET=change-moi-en-une-longue-chaine-aleatoire

# Compte admin initial (créé lors du seed)
ADMIN_EMAIL=admin@chicstyle.bj
ADMIN_PASSWORD=ChangeMoi123!

# Numéro WhatsApp de la boutique (Remplacez par votre vrai numéro au format 229XXXXXXXX)
WHATSAPP_NUMBER=22990000000

# Cloudinary (laisser vide pour les tests locaux)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Configuration serveur local
FRONTEND_URL=http://localhost:5173
PORT=4000
NODE_ENV=development