# ============================================
# Chic Style — Backend — Variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs
# ============================================

# URL de connexion PostgreSQL (fournie par Render PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Secret pour signer les JWT admin (générez une longue chaîne aléatoire)
JWT_SECRET=change-moi-en-une-longue-chaine-aleatoire

# Compte admin initial (créé par `npm run seed`)
ADMIN_EMAIL=admin@chicstyle.bj
ADMIN_PASSWORD=ChangeMoi123!

# Numéro WhatsApp de la boutique (format international, sans + ni espaces), ex: 22997000000
WHATSAPP_NUMBER=22900000000

# Cloudinary (stockage des images produits) — cloudinary.com, compte gratuit
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# URL(s) autorisée(s) pour CORS — l'URL de déploiement du frontend (séparer par des virgules si plusieurs)
FRONTEND_URL=http://localhost:5173

PORT=4000
NODE_ENV=development
